{
  "$comment": "Document-specific settings. Run `make inspect` and review; see tools/config.py for all keys and defaults.",
  "source_lang": "en",
  "target_lang": "ja",
  "page_size": "letter",
  "accent_color": "#2f5496",
  "cover": {
    "page": 1,
    "lines": 3
  },
  "skip_pages": [
    1,
    2,
    3
  ],
  "footer_y": 714,
  "heading": {
    "fonts": [
      "HelveticaNeue-Medium"
    ],
    "min_size": 10.5,
    "levels_by_x": {
      "72": 2,
      "90": 3,
      "108": 4
    }
  },
  "code": {
    "colors": [
      "#ee0000"
    ],
    "fonts": [
      "Courier"
    ],
    "indent": 200
  },
  "bullets": {
    "fonts": [
      "SymbolMT"
    ]
  },
  "caption": {
    "italic": true,
    "min_x": 150,
    "pattern": "^Figure \\d"
  },
  "table": {
    "size": null
  }
}
